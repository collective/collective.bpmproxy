<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_renovation_case" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="renovation-case" name="Renovation Case" isExecutable="true" camunda:historyTimeToLive="P30D">
    <bpmn:startEvent id="Start_case_created" name="Case created">
      <bpmn:outgoing>Flow_start_bind</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_case_created" messageRef="Message_case_created" />
    </bpmn:startEvent>
    <bpmn:scriptTask id="Activity_bind_case" name="Bind case">
      <bpmn:incoming>Flow_start_bind</bpmn:incoming>
      <bpmn:outgoing>Flow_bind_closed</bpmn:outgoing>
      <bpmn:script>${execution.setBusinessKey(caseUuid.concat(':').concat(execution.getProcessInstanceId()))}</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_start_bind" sourceRef="Start_case_created" targetRef="Activity_bind_case" />
    <bpmn:intermediateCatchEvent id="Catch_case_closed" name="Case closed">
      <bpmn:incoming>Flow_bind_closed</bpmn:incoming>
      <bpmn:outgoing>Flow_closed_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_case_closed" messageRef="Message_case_closed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_bind_closed" sourceRef="Activity_bind_case" targetRef="Catch_case_closed" />
    <bpmn:endEvent id="End_case_closed" name="Case process ended">
      <bpmn:incoming>Flow_closed_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_closed_end" sourceRef="Catch_case_closed" targetRef="End_case_closed" />
    <bpmn:subProcess id="Subprocess_document_review" name="Start page review" triggeredByEvent="true">
      <bpmn:startEvent id="Start_document_created" name="Document added" isInterrupting="false">
        <bpmn:outgoing>Flow_document_call</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_document_created" messageRef="Message_document_created" />
      </bpmn:startEvent>
      <bpmn:callActivity id="Call_page_review" name="Review added page" calledElement="renovation-page-review" camunda:businessKey="${caseUuid.concat(&#39;:&#39;).concat(childUuid)}">
        <bpmn:extensionElements>
          <camunda:in variables="all" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_document_call</bpmn:incoming>
        <bpmn:outgoing>Flow_document_review_end</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_document_call" sourceRef="Start_document_created" targetRef="Call_page_review" />
      <bpmn:endEvent id="End_document_reviewed" name="Document review complete">
        <bpmn:incoming>Flow_document_review_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_document_review_end" sourceRef="Call_page_review" targetRef="End_document_reviewed" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:message id="Message_case_created" name="renovation-case-created" />
  <bpmn:message id="Message_case_closed" name="renovation-case-closed" />
  <bpmn:message id="Message_document_created" name="renovation-case-document-created" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_renovation_case">
    <bpmndi:BPMNPlane id="BPMNPlane_renovation_case" bpmnElement="renovation-case">
      <bpmndi:BPMNShape id="Start_case_created_di" bpmnElement="Start_case_created">
        <dc:Bounds x="100" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="85" y="168" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_bind_case_di" bpmnElement="Activity_bind_case">
        <dc:Bounds x="196" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_case_closed_di" bpmnElement="Catch_case_closed">
        <dc:Bounds x="356" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="343.5" y="168" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_case_closed_di" bpmnElement="End_case_closed">
        <dc:Bounds x="452" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="436" y="161.5" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Subprocess_document_review_di" bpmnElement="Subprocess_document_review" isExpanded="true">
        <dc:Bounds x="100" y="240" width="400" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_document_created_di" bpmnElement="Start_document_created">
        <dc:Bounds x="130" y="297" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="106" y="343" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_page_review_di" bpmnElement="Call_page_review">
        <dc:Bounds x="226" y="275" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_document_reviewed_di" bpmnElement="End_document_reviewed">
        <dc:Bounds x="386" y="297" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="361.5" y="343.5" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_document_call_di" bpmnElement="Flow_document_call">
        <di:waypoint x="166" y="315" />
        <di:waypoint x="226" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_document_review_end_di" bpmnElement="Flow_document_review_end">
        <di:waypoint x="326" y="315" />
        <di:waypoint x="386" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_start_bind_di" bpmnElement="Flow_start_bind">
        <di:waypoint x="136" y="140" />
        <di:waypoint x="196" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_bind_closed_di" bpmnElement="Flow_bind_closed">
        <di:waypoint x="296" y="140" />
        <di:waypoint x="356" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_closed_end_di" bpmnElement="Flow_closed_end">
        <di:waypoint x="392" y="140" />
        <di:waypoint x="452" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
