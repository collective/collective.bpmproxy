# Process-level env vars for purjo's underlying operaton-tasks engine
# connection (distinct from secrets.json, which is a purjo Robot-task
# secret used only inside tasks.robot). The devenv fixture runs engine-rest
# with Keycloak-issued OAuth2 tokens required (the "oauth2" Spring profile
# devenv.nix always activates), so Basic Auth is not an alternative here.

# purjo/operaton-tasks default to port 8080 (Plone's port in this devenv
# stack) -- Operaton itself is on 8081 (see devenv.nix's CAMUNDA_API_URL).
ENGINE_REST_BASE_URL=http://localhost:8081/engine-rest

# These are the "operaton-worker" service-account client's credentials from
# devenv/keycloak/realm-plone.json: its token carries a hardcoded
# "operaton_username: admin" claim, so this worker authenticates to the
# engine as the built-in admin user.
OAUTH2_CLIENT_ID=operaton-worker
OAUTH2_CLIENT_SECRET=operaton-worker-secret
OAUTH2_TOKEN_URL=http://localhost:8082/realms/plone/protocol/openid-connect/token
