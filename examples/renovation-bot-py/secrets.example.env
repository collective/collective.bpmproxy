# Base URL of Operaton's engine-rest API (see devenv.nix's CAMUNDA_API_URL).
ENGINE_REST_BASE_URL=http://localhost:8081/engine-rest

# The devenv fixture runs engine-rest with Keycloak-issued OAuth2 tokens
# required (the "oauth2" Spring profile devenv.nix always activates), so
# Basic Auth is no longer accepted -- ENGINE_REST_AUTHORIZATION is not an
# alternative here. These are the "operaton-worker" service-account client's
# credentials from devenv/keycloak/realm-plone.json: its token carries a
# hardcoded "operaton_username: admin" claim, so this worker authenticates
# to the engine as the built-in admin user, the same identity Basic Auth
# used to resolve to.
OAUTH2_CLIENT_ID=operaton-worker
OAUTH2_CLIENT_SECRET=operaton-worker-secret
OAUTH2_TOKEN_URL=http://localhost:8082/realms/plone/protocol/openid-connect/token

# Base URL of the Plone site this worker transitions content on.
PLONE_URL=http://localhost:8080/Plone

# Authorization header for Plone's REST API -- the renovation-bot Site
# Administrator account created by the collective.bpmproxy:renovation_demo
# profile. Same credential ../renovation-bot/secrets.json uses.
PLONE_AUTHORIZATION=
