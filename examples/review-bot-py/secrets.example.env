# Base URL of Operaton's engine-rest API (see devenv.nix's CAMUNDA_API_URL).
ENGINE_REST_BASE_URL=http://localhost:8081/engine-rest

# The devenv fixture runs engine-rest with Keycloak-issued OAuth2 tokens
# required (the "oauth2" Spring profile devenv.nix always activates).
# Credentials from devenv/keycloak/realm-plone.json:
OAUTH2_CLIENT_ID=operaton-worker
OAUTH2_CLIENT_SECRET=operaton-worker-secret
OAUTH2_TOKEN_URL=http://localhost:8082/realms/plone/protocol/openid-connect/token

# Base URL of the Plone site this worker transitions content on.
PLONE_URL=http://localhost:8080/Plone

# Authorization header for Plone's REST API (e.g. "Basic YWRtaW46YWRtaW4=").
PLONE_AUTHORIZATION=
