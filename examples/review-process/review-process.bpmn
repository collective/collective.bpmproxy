      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_set_publish_di" bpmnElement="Activity_set_publish">
        <dc:Bounds x="970" y="90" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_set_reject_di" bpmnElement="Activity_set_reject">
        <dc:Bounds x="970" y="250" width="100" height="80" />
