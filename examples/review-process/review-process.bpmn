        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_05ii5a3_di" bpmnElement="Lane_05ii5a3" isHorizontal="true">
        <dc:Bounds x="55" y="400" width="1445" height="300" />
        <bpmndi:BPMNLabel />
