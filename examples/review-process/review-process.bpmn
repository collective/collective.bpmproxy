      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_sub_end_di" bpmnElement="Event_sub_end">
        <dc:Bounds x="566" y="507" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="543" y="554" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_substart_to_submit_di" bpmnElement="Flow_substart_to_submit">
        <di:waypoint x="186" y="525" />
