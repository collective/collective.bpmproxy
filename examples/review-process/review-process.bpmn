      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1uzkag7_di" bpmnElement="Flow_1uzkag7">
        <di:waypoint x="634" y="550" />
        <di:waypoint x="700" y="550" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_114qpzv_di" bpmnElement="Flow_114qpzv">
        <di:waypoint x="750" y="510" />
        <di:waypoint x="750" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_start_to_bind_di" bpmnElement="Flow_start_to_bind">
        <di:waypoint x="160" y="130" />
