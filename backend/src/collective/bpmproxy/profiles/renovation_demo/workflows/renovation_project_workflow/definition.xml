<?xml version="1.0" encoding="UTF-8"?>
<dc-workflow workflow_id="renovation_project_workflow" title="Renovation Case Workflow" description="The visible open/closed lifecycle for a BPMN-managed renovation case." state_variable="review_state" initial_state="open" manager_bypass="False">
  <permission>Access contents information</permission>
  <permission>Add portal content</permission>
  <permission>Modify portal content</permission>
  <permission>View</permission>
  <state state_id="open" title="Open">
    <description>The case accepts Documents and case events.</description>
    <exit-transition transition_id="close-case" />
    <permission-map name="Access contents information" acquired="False">
      <permission-role>Manager</permission-role><permission-role>Contributor</permission-role><permission-role>Editor</permission-role><permission-role>Reader</permission-role><permission-role>Reviewer</permission-role><permission-role>Site Administrator</permission-role>
    </permission-map>
    <permission-map name="Add portal content" acquired="False">
      <permission-role>Manager</permission-role><permission-role>Contributor</permission-role><permission-role>Editor</permission-role><permission-role>Site Administrator</permission-role>
    </permission-map>
    <permission-map name="Modify portal content" acquired="False">
      <permission-role>Manager</permission-role><permission-role>Editor</permission-role><permission-role>Site Administrator</permission-role>
    </permission-map>
    <permission-map name="View" acquired="False">
      <permission-role>Manager</permission-role><permission-role>Contributor</permission-role><permission-role>Editor</permission-role><permission-role>Reader</permission-role><permission-role>Reviewer</permission-role><permission-role>Site Administrator</permission-role>
    </permission-map>
  </state>
  <state state_id="closed" title="Closed">
    <description>The case is closed. It is retained for history.</description>
    <permission-map name="Access contents information" acquired="False">
      <permission-role>Manager</permission-role><permission-role>Contributor</permission-role><permission-role>Editor</permission-role><permission-role>Reader</permission-role><permission-role>Reviewer</permission-role><permission-role>Site Administrator</permission-role>
    </permission-map>
    <permission-map name="Add portal content" acquired="False"><permission-role>Manager</permission-role></permission-map>
    <permission-map name="Modify portal content" acquired="False"><permission-role>Manager</permission-role></permission-map>
    <permission-map name="View" acquired="False">
      <permission-role>Manager</permission-role><permission-role>Contributor</permission-role><permission-role>Editor</permission-role><permission-role>Reader</permission-role><permission-role>Reviewer</permission-role><permission-role>Site Administrator</permission-role>
    </permission-map>
  </state>
  <transition transition_id="close-case" title="Close case" new_state="closed" trigger="USER" before_script="" after_script="">
    <description>The case manager closes the case after its reviews and events are complete.</description>
    <action category="workflow" url="%(content_url)s/content_status_modify?workflow_action=close-case">Close case</action>
    <guard><guard-permission>Review portal content</guard-permission></guard>
  </transition>
</dc-workflow>
